# Copy to .env and fill in. .env is gitignored.
#
# Keys are SSH_-prefixed on purpose: zsh defines HOST and USERNAME as special
# parameters bound to your local machine and user, so plain names would get
# silently shadowed and deploy to the wrong target.

# Required — the deploy target.
SSH_HOST=
SSH_USER=

# SSH port. Leave blank to let ~/.ssh/config decide.
SSH_PORT=22

# Authentication is left to ssh: deploy.py assumes your agent or ~/.ssh/config
# connects to SSH_HOST without prompting for a password. SSH_USER needs
# passwordless sudo to take ownership of the target, plus docker access.

# Where dist/ contents land on the server. Defaults to /home/lux/apps/leonardomanrique.
TARGET=/home/lux/apps/leonardomanrique

# Where the pre-deploy backup is copied. Defaults to /home/lux/backups.
BACKUP_DIR=/home/lux/backups

# Container restarted after the sync (nginx runs in a container, not on the
# host). Defaults to traefik.
CONTAINER=traefik
